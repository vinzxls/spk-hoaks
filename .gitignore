# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Virtual environment ───────────────────────────────────
.venv/
venv/
env/

# ── Hasil ekspor pengguna ─────────────────────────────────
