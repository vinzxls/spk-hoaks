# masuk repo; strukturnya dibuat otomatis saat runtime.
exports/*
!exports/.gitkeep

# ── Berkas sementara ──────────────────────────────────────
*.log
*.tmp
~$*
Thumbs.db
desktop.ini

# ── IDE / editor ──────────────────────────────────────────
.vscode/
.idea/
